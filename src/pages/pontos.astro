---
// Consulta de pontos: um cartão com dois estados (número → saldo).
// A página só consulta; resgates fazem-se na oficina. Dados via Apps Script (ver sheets/README.md).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { u } from '../lib/url';
import { business } from '../data/business';
import { premiosDefault } from '../data/premios';
import { pontosMock } from '../data/pontos-mock';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Pontos', path: '/pontos/' },
];

const pontosApi = (import.meta.env.PUBLIC_PONTOS_API || 'mock').trim();
const premios = [...premiosDefault].sort((a, b) => a.pontos - b.pontos);
const mockJson = pontosApi === 'mock' ? JSON.stringify(pontosMock) : '';
---
<Base
  title="Os seus pontos | INOVACAR, Aveiro"
  description="Consulte o saldo de pontos INOVACAR com o seu telemóvel. 1 euro gasto = 1 ponto. Troque os pontos na oficina."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <section class="pts-page" data-pontos data-api={pontosApi} data-mock={mockJson} data-premios={JSON.stringify(premios)}>
    <div class="container pts-inner">
      <header class="pts-intro">
        <h1 class="t-display pts-title">Os seus pontos</h1>
        <p class="pts-lead">Cada euro gasto na oficina vale 1 ponto. Troque os pontos por ofertas e descontos.</p>
      </header>

      <div class="pts-card" data-pontos-card data-state="ask" aria-live="polite">
        <!-- Estado 1: pedir o número -->
        <form class="pts-ask" data-pontos-form novalidate>
          <label class="pts-label" for="pontos-tel">O seu telemóvel</label>
          <div class="pts-field" data-pontos-field>
            <span class="pts-prefix t-num" aria-hidden="true">+351</span>
            <input
              id="pontos-tel"
              class="pts-input t-num"
              type="tel"
              name="telemovel"
              inputmode="numeric"
              autocomplete="tel-national"
              placeholder="912 345 678"
              maxlength="11"
              required
              aria-describedby="pontos-help pontos-erro"
              data-pontos-tel
            />
            <button class="pts-go" type="submit" data-pontos-submit aria-label="Ver os meus pontos">
              <Icon name="arrow" class="pts-go-icon" />
              <span class="pts-spinner" aria-hidden="true"></span>
            </button>
          </div>
          <p class="pts-help t-small" id="pontos-help">Use o número que deu na oficina.</p>
          <p class="pts-error" id="pontos-erro" data-pontos-erro hidden></p>
        </form>

        <!-- Estado 2: resultado -->
        <div class="pts-result" data-pontos-result hidden>
          <div class="pts-result-head">
            <p class="pts-hello" data-pontos-hello></p>
            <button class="pts-reset" type="button" data-pontos-reset>Outro número</button>
          </div>

          <p class="pts-balance t-num">
            <span class="pts-balance-num" data-pontos-saldo>0</span>
            <span class="pts-balance-unit">pontos</span>
          </p>

          <div class="pts-next" data-pontos-next>
            <div class="pts-next-text">
              <span data-pontos-next-label></span>
              <strong class="t-num" data-pontos-next-gap></strong>
            </div>
            <div class="pts-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-pontos-meter>
              <span class="pts-meter-fill" data-pontos-meter-fill></span>
            </div>
          </div>

          <ul role="list" class="pts-rewards" data-pontos-rewards></ul>

          <details class="pts-history" data-pontos-history>
            <summary>Ver movimentos <Icon name="chevron" class="pts-history-icon" /></summary>
            <ul role="list" class="pts-moves" data-pontos-movimentos></ul>
          </details>

          <a class="btn btn-primary pts-call" href={business.phoneHref}>
            <Icon name="phone" class="btn-icon" />Trocar pontos: ligar {business.phoneDisplay}
          </a>
        </div>
      </div>

      <ul role="list" class="pts-rules">
        <li><strong class="t-num">1 €</strong><span>= 1 ponto</span></li>
        <li><strong class="t-num">300</strong><span>pontos por cada amigo que trouxer</span></li>
        <li><strong>Na oficina</strong><span>é onde troca os pontos</span></li>
      </ul>

      <section class="pts-catalog" aria-labelledby="catalogo-title" data-pontos-catalog>
        <h2 class="t-h3" id="catalogo-title">O que pode receber</h2>
        <ul role="list" class="pts-catalog-list">
          {premios.map((p) => (
            <li><span>{p.nome}</span><span class="t-num">{p.pontos} pts</span></li>
          ))}
        </ul>
      </section>

      <p class="pts-privacy t-small">
        O número serve apenas para consultar os seus pontos. Dúvidas? <a href={business.phoneHref}>Ligue {business.phoneDisplay}</a> ou veja os <a href={u('/contactos/')}>contactos</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/pontos.js';
</script>

<style is:global>
  /* Global porque a lista de prémios e os movimentos são criados por JavaScript. Tudo prefixado com pts-. */
  .pts-page [hidden] { display: none !important; }
  .pts-page {
    background:
      linear-gradient(var(--brand-dark), var(--brand-dark)) top / 100% 300px no-repeat,
      var(--surface-muted);
    padding-block: var(--space-7) var(--space-8);
  }
  .pts-inner { max-width: calc(560px + 2 * 16px); display: grid; gap: var(--space-5); }
  .pts-intro { color: var(--ink-on-dark); display: grid; gap: var(--space-2); }
  .pts-title { font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.2rem); }
  .pts-lead { color: var(--ink-on-dark-soft); font-size: var(--fs-lead); line-height: 1.45; }

  /* Cartão principal */
  .pts-card {
    position: relative;
    background: var(--surface-white);
    border-radius: var(--radius-l);
    box-shadow: 0 24px 48px -24px rgba(38, 41, 60, 0.45), 0 2px 6px rgba(38, 41, 60, 0.06);
    padding: var(--space-6);
    overflow: hidden;
    transition: height var(--dur-slow) var(--ease);
  }
  .pts-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--brand-turquoise);
    transform-origin: left;
    transform: scaleX(0.18);
    transition: transform 700ms var(--ease);
  }
  .pts-card[data-state='result']::before { transform: scaleX(1); }

  /* Estado: pedir número */
  .pts-ask { display: grid; gap: var(--space-2); }
  .pts-label { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; }
  .pts-field {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    border: 2px solid var(--line);
    border-radius: var(--radius-l);
    padding: 6px 6px 6px 16px;
    background: var(--surface-white);
    transition: border-color var(--dur-quick) var(--ease), box-shadow var(--dur-quick) var(--ease);
  }
  .pts-field:focus-within { border-color: var(--brand-turquoise); box-shadow: 0 0 0 4px rgba(54, 179, 175, 0.18); }
  .pts-field.is-invalid { border-color: #b42318; }
  .pts-field.shake { animation: pts-shake 340ms var(--ease); }
  @keyframes pts-shake {
    20% { transform: translateX(-8px); }
    45% { transform: translateX(6px); }
    70% { transform: translateX(-3px); }
    100% { transform: none; }
  }
  .pts-prefix { color: var(--ink-soft); font-weight: 600; font-size: 1.15rem; }
  .pts-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    padding: 12px 4px;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.7rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    background: transparent;
  }
  .pts-input::placeholder { color: #a3a8b5; font-weight: 500; }
  .pts-go {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 0;
    border-radius: var(--radius-m);
    background: var(--brand-turquoise);
    color: var(--brand-dark);
    cursor: pointer;
    transition: background-color var(--dur-quick) var(--ease), transform var(--dur-quick) var(--ease);
  }
  .pts-go:hover { background: var(--brand-turquoise-hover); }
  .pts-go:active { transform: scale(0.94); }
  .pts-go-icon { width: 24px; height: 24px; transition: transform var(--dur-standard) var(--ease); }
  .pts-go:hover .pts-go-icon { transform: translateX(3px); }
  .pts-spinner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 3px solid var(--brand-dark);
    border-right-color: transparent;
    border-radius: 50%;
    opacity: 0;
    animation: pts-spin 0.7s linear infinite;
  }
  .pts-go.is-loading .pts-go-icon { opacity: 0; }
  .pts-go.is-loading .pts-spinner { opacity: 1; }
  @keyframes pts-spin { to { transform: rotate(360deg); } }
  .pts-help { color: var(--ink-soft); }
  .pts-error { color: #b42318; font-weight: 600; font-size: var(--fs-small); }

  /* Troca de estado: sai depressa, entra com calma */
  .pts-ask.is-leaving { animation: pts-out 180ms var(--ease) forwards; }
  .pts-result.is-entering { animation: pts-in 360ms var(--ease-out) both; }
  @keyframes pts-out { to { opacity: 0; transform: translateY(-8px); } }
  @keyframes pts-in { from { opacity: 0; transform: translateY(12px); } }

  /* Estado: resultado */
  .pts-result { display: grid; gap: var(--space-5); }
  .pts-result-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
  .pts-hello { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; }
  .pts-hello:focus:not(:focus-visible) { outline: none; }
  .pts-reset {
    border: 0;
    background: none;
    padding: 6px 0;
    color: var(--brand-turquoise-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .pts-balance { display: flex; align-items: baseline; gap: var(--space-3); line-height: 0.9; margin-top: calc(-1 * var(--space-2)); }
  .pts-balance-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4rem, 3rem + 5vw, 5.75rem);
    letter-spacing: -0.02em;
    color: var(--brand-dark);
  }
  .pts-balance-unit { font-weight: 600; color: var(--ink-soft); font-size: 1.1rem; }

  .pts-next { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--surface-muted); border-radius: var(--radius-m); }
  .pts-next-text { display: flex; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; }
  .pts-next-text strong { color: var(--brand-turquoise-ink); white-space: nowrap; }
  .pts-meter { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .pts-meter-fill {
    display: block;
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: var(--brand-turquoise);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 800ms var(--ease) 350ms;
  }

  .pts-rewards { display: grid; }
  .pts-reward {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    animation: pts-in 320ms var(--ease-out) both;
    animation-delay: calc(500ms + var(--i, 0) * 45ms);
  }
  .pts-reward:last-child { border-bottom: 0; }
  .pts-badge {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--line);
    color: var(--ink-soft);
  }
  .pts-badge svg { width: 16px; height: 16px; }
  .pts-reward.is-ok .pts-badge { background: var(--brand-turquoise); border-color: var(--brand-turquoise); color: var(--brand-dark); }
  .pts-reward-name { font-weight: 600; }
  .pts-reward-cost { font-size: var(--fs-small); color: var(--ink-soft); white-space: nowrap; text-align: right; }
  .pts-reward.is-ok .pts-reward-cost { color: var(--brand-turquoise-ink); font-weight: 600; }
  .pts-reward:not(.is-ok) .pts-reward-name { color: var(--ink-soft); }

  .pts-history { border-top: 1px solid var(--line); padding-top: var(--space-3); }
  .pts-history summary { display: flex; align-items: center; gap: var(--space-2); cursor: pointer; font-weight: 600; list-style: none; padding: 6px 0; }
  .pts-history summary::-webkit-details-marker { display: none; }
  .pts-history-icon { width: 18px; height: 18px; transition: transform var(--dur-standard) var(--ease); }
  .pts-history[open] .pts-history-icon { transform: rotate(180deg); }
  .pts-moves { display: grid; margin-top: var(--space-2); }
  .pts-move { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--space-3); padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 0.97rem; }
  .pts-move:last-child { border-bottom: 0; }
  .pts-move-what { font-weight: 600; }
  .pts-move-when { grid-column: 1; color: var(--ink-soft); font-size: var(--fs-small); }
  .pts-move-pts { grid-row: 1 / span 2; grid-column: 2; align-self: center; font-weight: 700; }
  .pts-move-pts.is-pos { color: var(--brand-turquoise-ink); }
  .pts-move-pts.is-neg { color: var(--ink-soft); }
  .pts-call { justify-self: stretch; }

  /* Regras e catálogo (sempre visíveis, discretos) */
  .pts-rules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .pts-rules li { display: grid; gap: 2px; padding: var(--space-4); background: var(--surface-white); border-radius: var(--radius-m); font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.35; }
  .pts-rules strong { font-family: var(--font-display); font-size: 1.35rem; color: var(--brand-dark); }
  .pts-catalog { display: grid; gap: var(--space-3); }
  .pts-catalog[hidden] { display: none; }
  .pts-catalog-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-5); }
  .pts-catalog-list li { display: flex; justify-content: space-between; gap: var(--space-3); padding: 10px 0; border-bottom: 1px solid var(--line); }
  .pts-catalog-list li span:last-child { color: var(--ink-soft); white-space: nowrap; }
  .pts-privacy { color: var(--ink-soft); }

  @media (max-width: 560px) {
    .pts-page { background-size: 100% 260px, auto; padding-top: var(--space-6); }
    .pts-card { padding: var(--space-5) var(--space-4); }
    .pts-rules { grid-template-columns: 1fr; }
    .pts-rules li { grid-template-columns: auto 1fr; align-items: baseline; gap: var(--space-2); }
    .pts-catalog-list { grid-template-columns: 1fr; }
    .pts-go { width: 52px; height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pts-reward, .pts-result.is-entering, .pts-ask.is-leaving { animation: none; }
    .pts-meter-fill, .pts-card::before { transition: none; }
  }
</style>
