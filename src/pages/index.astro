---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBand from '../components/TrustBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import MapSection from '../components/MapSection.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import { photos, srcset, src } from '../data/images';
import { faqSchema, homeFaqs } from '../data/schema';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);
// Trabalhos só entram quando forem reais e tiverem fotos do antes e do depois.
const projetos = (await getCollection('projetos')).filter((p) => !p.data.placeholder && p.data.beforePhoto && p.data.afterPhoto);

// Galeria em mosaico: uma foto larga e uma alta em cima, quatro em baixo.
const gallery = [
  { key: 'zonaTrabalho', cls: 'g-wide', sizes: '(max-width: 760px) 100vw, 60vw' },
  { key: 'ferrari', cls: 'g-tall', sizes: '(max-width: 760px) 100vw, 40vw' },
  { key: 'maserati', cls: 'g-wide2', sizes: '(max-width: 760px) 100vw, 60vw' },
  { key: 'oleo', cls: 'g-small', sizes: '(max-width: 760px) 50vw, 25vw' },
  { key: 'roda', cls: 'g-small', sizes: '(max-width: 760px) 50vw, 25vw' },
  { key: 'motor', cls: 'g-small', sizes: '(max-width: 760px) 50vw, 25vw' },
  { key: 'interior', cls: 'g-small', sizes: '(max-width: 760px) 50vw, 25vw' },
] as const;

---
<Base
  title="INOVACAR - Oficina Automóvel em Cacia e Aveiro | 934 514 368"
  description="Oficina automóvel na R. da Paz, Aveiro, perto de Cacia. Manutenção, travões, diagnóstico, embraiagem e reparações mecânicas. Ligue 934 514 368."
  schema={[faqSchema(homeFaqs)]}
>
  <Hero />
  <TrustBand />

  <section class="section" aria-labelledby="servicos-title">
    <div class="container">
      <div class="home-head">
        <div class="section-head" data-reveal>
          <h2 class="t-h2" id="servicos-title">O que fazemos</h2>
          <p class="t-lead">Manutenção e reparação mecânica para o carro do dia a dia. Diga-nos o que o carro está a fazer e indicamos o passo seguinte.</p>
        </div>
        <a class="link-arrow" href={u('/servicos/')}>Todos os serviços <Icon name="arrow" /></a>
      </div>
      <ServiceCards items={servicos} />
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="sobre-title">
    <div class="container about">
      <figure class="about-photo" data-reveal="clip">
        <img src={src(photos.interior, 800)} srcset={srcset(photos.interior)} sizes="(max-width: 860px) 100vw, 45vw" width={photos.interior.width} height={photos.interior.height} alt={photos.interior.alt} loading="lazy" decoding="async" />
        </figure>
      <div class="about-copy" data-reveal style="--d:120ms">
        <h2 class="t-h2" id="sobre-title">Uma oficina na R. da Paz, entre Cacia e Aveiro</h2>
        <p class="t-lead">A INOVACAR é uma oficina automóvel em Aveiro. Tratamos da manutenção e da reparação mecânica de automóveis: revisões, travões, diagnóstico de avarias, baterias, suspensão, embraiagem e distribuição.</p>
        <p class="t-body t-soft">Pode ligar diretamente para a oficina e falar sobre o seu carro antes de o trazer.</p>
        <a class="link-arrow" href={u('/sobre-nos/')}>Conhecer a oficina <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="galeria-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="t-h2" id="galeria-title">Dentro da oficina</h2>
        <p class="t-lead">A nossa zona de trabalho na R. da Paz, em Aveiro.</p>
      </div>
      <div class="gallery">
        {gallery.map((g, i) => (
          <button type="button" class={`gallery-item ${g.cls}`} data-reveal="clip" style={`--d:${i * 70}ms`} data-lightbox={src(photos[g.key])} data-alt={photos[g.key].alt} aria-label={`Ampliar: ${photos[g.key].alt}`}>
            <img src={src(photos[g.key], 800)} srcset={srcset(photos[g.key])} sizes={g.sizes} width={photos[g.key].width} height={photos[g.key].height} alt="" loading="lazy" decoding="async" />
            <span class="gallery-zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5M11 8v6M8 11h6"/></svg></span>
          </button>
        ))}
      </div>
      <dialog class="lightbox" data-lightbox-dialog aria-label="Fotografia ampliada">
        <img class="lightbox-img" data-lightbox-img alt="" />
        <button type="button" class="lightbox-btn lightbox-prev" data-lightbox-prev aria-label="Anterior"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="lightbox-btn lightbox-next" data-lightbox-next aria-label="Seguinte"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
        <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="Fechar"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        <p class="lightbox-count t-num" data-lightbox-count></p>
      </dialog>

      {projetos.length > 0 && (
        <div class="projects">
          <h3 class="t-h3">Trabalhos realizados</h3>
          <ul role="list" class="projects-list">
            {projetos.map((p) => (
              <li class="project">
                <div class="project-pair">
                  <figure><img src={p.data.beforePhoto} alt={`Antes: ${p.data.title}`} loading="lazy" /><figcaption class="t-label">Antes</figcaption></figure>
                  <figure><img src={p.data.afterPhoto} alt={`Depois: ${p.data.title}`} loading="lazy" /><figcaption class="t-label">Depois</figcaption></figure>
                </div>
                <h4 class="t-h3">{p.data.title}</h4>
                <p class="t-soft">{p.data.story}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <MapSection />


  <section class="section" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <div class="section-head" data-reveal>
        <h2 class="t-h2" id="faq-title">Perguntas frequentes</h2>
        <p class="t-lead">Se a sua dúvida não estiver aqui, ligue para a oficina.</p>
      </div>
      <FaqList faqs={homeFaqs} />
    </div>
  </section>
</Base>

<script>
  // Galeria: abre a foto em grande; setas, teclado e deslizar para mudar.
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-lightbox]')];
  if (dlg && items.length) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let at = 0;
    const show = (i: number, dir = 0) => {
      at = (i + items.length) % items.length;
      img.src = items[at].dataset.lightbox!;
      img.alt = items[at].dataset.alt || '';
      count.textContent = `${at + 1} / ${items.length}`;
      img.style.setProperty('--from', `${dir * 40}px`);
      img.classList.remove('is-swap');
      void img.offsetWidth;
      img.classList.add('is-swap');
    };
    items.forEach((el, i) => el.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelector('[data-lightbox-prev]')!.addEventListener('click', () => show(at - 1, -1));
    dlg.querySelector('[data-lightbox-next]')!.addEventListener('click', () => show(at + 1, 1));
    dlg.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1, 1);
      if (e.key === 'ArrowLeft') show(at - 1, -1);
    });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });
  }
</script>

<style>
  .home-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-5); flex-wrap: wrap; margin-bottom: var(--space-7); }
  .home-head .section-head { margin-bottom: 0; }

  .about { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-8); align-items: center; }
  .about-photo { border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 4 / 5; max-width: 100%; box-shadow: var(--shadow-raised); }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  .about-copy { display: grid; gap: var(--space-5); justify-items: start; }

  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 15vw, 220px); gap: var(--space-3); }
  .gallery-item {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--brand-dark);
    cursor: zoom-in;
  }
  .gallery-item img { transition: transform 900ms var(--ease-out), filter var(--dur-slow) var(--ease); }
  .gallery-item:hover img, .gallery-item:focus-visible img { transform: scale(1.06); filter: brightness(0.85); }
  .gallery-zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--surface-white);
    color: var(--brand-dark);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity var(--dur-standard) var(--ease), transform var(--dur-standard) var(--ease);
  }
  .gallery-item:hover .gallery-zoom, .gallery-item:focus-visible .gallery-zoom { opacity: 1; transform: none; }

  .lightbox {
    width: min(1100px, 100vw);
    max-width: 100vw;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .lightbox::backdrop { background: rgba(16, 18, 28, 0.92); }
  .lightbox[open] { animation: lb-in 260ms var(--ease-out); }
  @keyframes lb-in { from { opacity: 0; transform: scale(0.96); } }
  .lightbox-img { display: block; width: 100%; max-height: 82dvh; object-fit: contain; border-radius: var(--radius-l); }
  .lightbox-img.is-swap { animation: lb-swap 320ms var(--ease-out); }
  @keyframes lb-swap { from { opacity: 0; transform: translateX(var(--from, 0)); } }
  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-white);
    color: var(--brand-dark);
    cursor: pointer;
    transition: transform var(--dur-quick) var(--ease), background-color var(--dur-quick) var(--ease);
  }
  .lightbox-btn:hover { background: var(--brand-turquoise); }
  .lightbox-btn:active { transform: scale(0.92); }
  .lightbox-prev { left: 12px; top: 50%; margin-top: -24px; }
  .lightbox-next { right: 12px; top: 50%; margin-top: -24px; }
  .lightbox-close { right: 12px; top: 12px; }
  .lightbox-count { text-align: center; color: #c9cdd8; margin-top: var(--space-3); font-size: var(--fs-small); }
  .g-wide { grid-column: span 3; grid-row: span 2; }
  .g-tall { grid-column: span 1; grid-row: span 3; }
  .g-wide2 { grid-column: span 3; grid-row: span 1; }
  .g-small { grid-column: span 1; grid-row: span 1; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; }

  .projects { margin-top: var(--space-8); display: grid; gap: var(--space-5); }
  .projects-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-6); }
  .project { display: grid; gap: var(--space-3); }
  .project-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  .project-pair img { aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-s); }


  @media (max-width: 960px) {
  }
  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; gap: var(--space-6); }
    .about-photo { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 760px) {
    /* Telemóvel: galeria em carrossel horizontal. */
    .gallery {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter)) calc(-1 * var(--gutter-r));
      padding: 0 var(--gutter-r) var(--space-2) var(--gutter);
      scrollbar-width: none;
    }
    .gallery::-webkit-scrollbar { display: none; }
    .gallery-item { flex: 0 0 82%; height: 250px; scroll-snap-align: start; }
    .g-tall { flex-basis: 56%; }
    .gallery-zoom { opacity: 1; transform: none; width: 32px; height: 32px; }
  }
  @media (max-width: 560px) {
  }
</style>
