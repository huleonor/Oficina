---
import { u } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { breadcrumbSchema } from '../../data/schema';

const localidades = (await getCollection('localidades')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Localidades', path: '/localidades/' },
];
---
<Base
  title="Localidades perto da oficina: Cacia, Aveiro e arredores | INOVACAR"
  description="A INOVACAR fica na R. da Paz, Aveiro. Distâncias e informação para clientes de Cacia, Aveiro, Esgueira, Eixo, Angeja, Albergaria-a-Velha, Estarreja e Ílhavo."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <PageHero
    title="Localidades perto da oficina"
    lead="Temos uma só oficina, na R. da Paz em Aveiro. Estas são as zonas de onde se chega em poucos minutos de carro."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container">
      <ul role="list" class="loc-list">
        {localidades.map((l) => (
          <li>
            <a class="loc-row" href={u(`/localidades/${l.id}/`)}>
              <div class="loc-main">
                <h2 class="loc-city">{l.data.city}</h2>
                <p class="t-soft">{l.data.intro}</p>
              </div>
              <div class="loc-meta">
                <span class="t-label">Tempo de viagem</span>
                <span class="loc-time">{l.data.driveTime}</span>
              </div>
              <Icon name="arrow" class="loc-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .loc-list { border-top: 2px solid var(--line-strong); }
  .loc-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6) var(--space-2);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background-color var(--dur-standard) var(--ease);
  }
  .loc-row:hover { background: var(--surface-muted); }
  .loc-main { display: grid; gap: var(--space-2); max-width: 68ch; }
  .loc-city { font-family: var(--font-display); font-size: 1.8rem; line-height: 1.1; }
  .loc-meta { display: grid; gap: 4px; }
  .loc-meta .t-label { color: var(--ink-soft); }
  .loc-time { font-weight: 600; }
  .loc-arrow { width: 24px; height: 24px; transition: transform var(--dur-standard) var(--ease); }
  .loc-row:hover .loc-arrow { transform: translateX(5px); }
  @media (max-width: 760px) {
    .loc-row { grid-template-columns: 1fr auto; gap: var(--space-3); padding-inline: 0; }
    .loc-meta { grid-column: 1; }
    .loc-arrow { grid-row: 1; grid-column: 2; }
  }
</style>
