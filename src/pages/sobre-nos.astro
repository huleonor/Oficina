---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { u } from '../lib/url';
import { business } from '../data/business';
import { resumo } from '../lib/horario';
import { photos, srcset, src } from '../data/images';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Sobre nós', path: '/sobre-nos/' },
];
const servicos = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);

// Diferenciais indicados pelo dono da oficina.
const diferenciais = [
  { t: 'Transparência', d: 'Explicamos o que encontrámos no carro e o orçamento antes de avançar com a reparação.' },
  { t: 'Acompanhamento durante o processo', d: 'Damos-lhe notícias do carro enquanto está na oficina e explicamos o que foi feito quando o vem buscar.' },
  { t: 'Atendimento direto', d: 'Fala diretamente com a oficina pelo 934 514 368, sem intermediários.' },
];
const fotos = ['ferrari', 'maserati', 'oleo', 'roda'] as const;
---
<Base
  title="Sobre a INOVACAR, oficina automóvel na R. da Paz, Aveiro"
  description="Conheça a INOVACAR, oficina automóvel na R. da Paz em Aveiro, perto de Cacia. Manutenção e reparação mecânica. Ligue 934 514 368."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <PageHero
    title="Sobre a INOVACAR"
    lead="Uma oficina automóvel na R. da Paz, em Aveiro, entre Cacia e o centro da cidade."
    crumbs={crumbs}
    photo="zonaTrabalho"
  />

  <section class="section ab-intro">
    <div class="container ab-intro-grid">
      <div class="ab-copy" data-reveal>
        <h2 class="t-h2">A oficina</h2>
        <p class="t-lead">A INOVACAR faz manutenção e reparação mecânica de automóveis, na R. da Paz, em Aveiro.</p>
        <p class="t-soft">Pode ligar diretamente para a oficina e falar sobre o seu carro antes de o trazer. Diga-nos a marca, o modelo e o que está a acontecer, e indicamos o passo seguinte.</p>
      </div>
      <figure class="ab-photo" data-reveal="clip">
        <img src={src(photos.interior, 800)} srcset={srcset(photos.interior)} sizes="(max-width: 960px) 100vw, 40vw" width={photos.interior.width} height={photos.interior.height} alt={photos.interior.alt} loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section-tight ab-band" aria-labelledby="distingue-title">
    <div class="container">
      <h2 class="t-h3 ab-title" id="distingue-title" data-reveal>O que nos distingue</h2>
    </div>
    <div class="container ab-scroller-wrap">
      <ol role="list" class="ab-scroller ab-diffs">
        {diferenciais.map((d, i) => (
          <li class="ab-diff" data-reveal style={`--d:${i * 80}ms`}>
            <span class="ab-diff-n t-num" aria-hidden="true">{i + 1}</span>
            <h3 class="ab-diff-t">{d.t}</h3>
            <p>{d.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="fazemos-title">
    <div class="container">
      <h2 class="t-h3 ab-title" id="fazemos-title" data-reveal>O que fazemos</h2>
      <ul role="list" class="ab-chips" data-reveal>
        {servicos.map((s) => (
          <li>
            <a class="ab-chip" href={u(`/servicos/${s.id}/`)}>
              <ServiceIcon name={s.data.icon} class="ab-chip-icon" />{s.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight section-muted" aria-labelledby="pratico-title">
    <div class="container">
      <h2 class="t-h3 ab-title" id="pratico-title" data-reveal>Informação prática</h2>
      <ul role="list" class="ab-info" data-reveal>
        <li>
          <a class="ab-row" href={business.directionsHref} target="_blank" rel="noopener">
            <span class="ab-row-icon"><Icon name="pin" /></span>
            <span class="ab-row-text"><span class="ab-row-label">Morada</span>{business.address.full}</span>
            <Icon name="arrow" class="ab-row-go" />
          </a>
        </li>
        <li>
          <div class="ab-row">
            <span class="ab-row-icon"><Icon name="clock" /></span>
            <span class="ab-row-text t-num"><span class="ab-row-label">Horário</span><span><span data-horario="curto">{resumo().curto}</span> · <span data-horario="fechado">{resumo().fechadoCurto} fechado</span></span></span>
          </div>
        </li>
        <li>
          <a class="ab-row" href={business.phoneHref}>
            <span class="ab-row-icon"><Icon name="phone" /></span>
            <span class="ab-row-text t-num"><span class="ab-row-label">Telefone</span>{business.phoneIntl}</span>
            <Icon name="arrow" class="ab-row-go" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section-tight ab-photos" aria-labelledby="fotos-title">
    <div class="container">
      <h2 class="t-h3 ab-title" id="fotos-title" data-reveal>Fotografias da oficina</h2>
    </div>
    <div class="container ab-scroller-wrap">
      <ul role="list" class="ab-scroller ab-gallery">
        {fotos.map((k, i) => (
          <li class="ab-shot" data-reveal="clip" style={`--d:${i * 80}ms`}>
            <img src={src(photos[k], 800)} srcset={srcset(photos[k])} sizes="(max-width: 760px) 80vw, 25vw" width={photos[k].width} height={photos[k].height} alt={photos[k].alt} loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .ab-title { font-size: 1.5rem; margin-bottom: var(--space-4); }

  .ab-intro-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: var(--space-8); align-items: center; }
  .ab-copy { display: grid; gap: var(--space-4); max-width: 60ch; }
  .ab-photo { border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 4 / 3; box-shadow: var(--shadow-raised); }
  .ab-photo img { width: 100%; height: 100%; object-fit: cover; }

  /* Listas horizontais: grelha no computador, carrossel no telemóvel */
  .ab-scroller { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .ab-diff {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    background: var(--surface-white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brand-turquoise);
    transition: transform var(--dur-standard) var(--ease), box-shadow var(--dur-standard) var(--ease);
  }
  .ab-diff:hover { transform: translateY(-3px); box-shadow: 0 14px 28px -16px rgba(38, 41, 60, 0.4); }
  .ab-diff-t { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; line-height: 1.2; margin-top: var(--space-2); }
  .ab-diff-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(54, 179, 175, 0.16);
    color: var(--brand-turquoise-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .ab-diff p { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.45; }

  .ab-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ab-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 8px 14px 8px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-white);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color var(--dur-quick) var(--ease), background-color var(--dur-quick) var(--ease), transform var(--dur-quick) var(--ease);
  }
  .ab-chip:hover { border-color: var(--brand-dark); transform: translateY(-2px); }
  .ab-chip:active { transform: scale(0.97); }
  .ab-chip-icon { width: 28px; height: 28px; padding: 3px; border-radius: 50%; background: rgba(54, 179, 175, 0.14); }

  .ab-info { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .ab-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-l);
    background: var(--surface-white);
    text-decoration: none;
    transition: transform var(--dur-quick) var(--ease), box-shadow var(--dur-standard) var(--ease);
  }
  a.ab-row:hover { transform: translateY(-2px); box-shadow: 0 12px 24px -16px rgba(38, 41, 60, 0.45); }
  .ab-row-icon { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: rgba(54, 179, 175, 0.16); color: var(--brand-dark); }
  .ab-row-icon :global(svg) { width: 18px; height: 18px; }
  .ab-row-text { display: grid; gap: 2px; font-weight: 600; line-height: 1.3; min-width: 0; }
  .ab-row-label { font-size: var(--fs-label); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); font-weight: 600; }
  .ab-row-go { width: 18px; height: 18px; margin-left: auto; flex: none; color: var(--ink-soft); transition: transform var(--dur-standard) var(--ease); }
  a.ab-row:hover .ab-row-go { transform: translateX(4px); }

  .ab-gallery { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ab-shot { border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 4 / 3; background: var(--brand-dark); }
  .ab-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .ab-shot:hover img { transform: scale(1.05); }

  @media (max-width: 960px) {
    .ab-intro-grid { grid-template-columns: 1fr; gap: var(--space-5); }
    .ab-info { grid-template-columns: 1fr; gap: var(--space-2); }
  }

  @media (max-width: 760px) {
    .ab-intro { padding-block: var(--space-6) var(--space-4); }
    .ab-copy .t-h2 { font-size: 1.6rem; }
    .ab-photo { aspect-ratio: 16 / 10; }
    .ab-title { font-size: 1.25rem; margin-bottom: var(--space-3); }
    .ab-scroller-wrap { padding: 0; }
    .ab-scroller {
      display: flex;
      gap: var(--space-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding: 2px var(--gutter-r) var(--space-2) var(--gutter);
      scrollbar-width: none;
    }
    .ab-scroller::-webkit-scrollbar { display: none; }
    .ab-diff { flex: 0 0 72%; scroll-snap-align: start; padding: var(--space-4); }
    .ab-shot { flex: 0 0 78%; scroll-snap-align: start; }
    .ab-chip { font-size: 0.88rem; padding: 6px 12px 6px 6px; }
    .ab-chip-icon { width: 24px; height: 24px; }
    .ab-row { padding: 12px 14px; }
    .ab-row-text { font-size: 0.95rem; }
  }
</style>
