---
// Contactos: tudo à volta de três ações (ligar, ir, escrever). Marcações só por telefone.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { business, mapEmbed } from '../data/business';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Contactos', path: '/contactos/' },
];
// Segunda (1) a domingo (0), na ordem portuguesa.
const semana = [
  { d: 1, nome: 'Segunda', h: '09:00 – 18:30' },
  { d: 2, nome: 'Terça', h: '09:00 – 18:30' },
  { d: 3, nome: 'Quarta', h: '09:00 – 18:30' },
  { d: 4, nome: 'Quinta', h: '09:00 – 18:30' },
  { d: 5, nome: 'Sexta', h: '09:00 – 18:30' },
  { d: 6, nome: 'Sábado', h: 'Fechado' },
  { d: 0, nome: 'Domingo', h: 'Fechado' },
];
---
<Base
  title="Contactos e marcações | INOVACAR, Aveiro | 934 514 368"
  description="Para marcar, ligue 934 514 368. INOVACAR, R. da Paz, 3800-587 Aveiro. Aberto de segunda a sexta, das 09:00 às 18:30."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <PageHero
    title="Contactos"
    lead="As marcações são feitas por telefone. Diga-nos o carro e o que está a acontecer, e combinamos o dia."
    crumbs={crumbs}
    actions={false}
  />

  <section class="ct">
    <div class="container ct-grid">
      <!-- Cartão principal: telefone + estado ao vivo -->
      <div class="ct-call" data-reveal data-open-status>
        <p class="ct-status"><span class="ct-dot" aria-hidden="true"></span><span data-open-label>Horário</span> <span class="ct-status-detail" data-open-value>{business.hours.short}</span></p>
        <p class="ct-call-label">Para marcar, ligue</p>
        <a class="ct-phone t-num" href={business.phoneHref}>{business.phoneDisplay}</a>
        <div class="ct-call-actions">
          <a class="btn btn-primary" href={business.phoneHref}><Icon name="phone" class="btn-icon" />Ligar agora</a>
          <button type="button" class="btn btn-outline-light ct-copy" data-copy={business.phoneDisplay}>
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <span data-copy-label>Copiar número</span>
          </button>
        </div>
      </div>

      <!-- Ações rápidas -->
      <ul role="list" class="ct-actions">
        <li data-reveal style="--d:60ms">
          <a class="ct-action" href={business.directionsHref} target="_blank" rel="noopener">
            <span class="ct-action-icon"><Icon name="pin" /></span>
            <span class="ct-action-text"><strong>Como chegar</strong><span>{business.address.street}, {business.address.postalCode} {business.address.locality}</span></span>
            <Icon name="arrow" class="ct-action-go" />
          </a>
        </li>
        {business.showEmail && (
          <li data-reveal style="--d:120ms">
            <a class="ct-action" href={`mailto:${business.email}`}>
              <span class="ct-action-icon"><Icon name="mail" /></span>
              <span class="ct-action-text"><strong>Email</strong><span>{business.email}</span></span>
              <Icon name="arrow" class="ct-action-go" />
            </a>
          </li>
        )}
      </ul>

      <!-- Horário da semana, com o dia de hoje destacado -->
      <div class="ct-hours" data-reveal style="--d:120ms">
        <h2 class="ct-h">Horário</h2>
        <ul role="list" class="ct-week t-num">
          {semana.map((w) => (
            <li class={`ct-day${w.h === 'Fechado' ? ' is-closed' : ''}`} data-dia={w.d}>
              <span>{w.nome}</span><span>{w.h}</span>
            </li>
          ))}
        </ul>
        <p class="ct-note">{business.hours.note}</p>
      </div>
    </div>
  </section>

  <section class="ct-map-wrap" aria-labelledby="mapa-title">
    <div class="container">
      <h2 class="ct-h" id="mapa-title" data-reveal>Onde estamos</h2>
      <div class="ct-map" data-reveal>
        {mapEmbed ? (
          <Fragment set:html={mapEmbed} />
        ) : (
          <iframe src={business.mapSrc} title="Mapa com a localização da INOVACAR na R. da Paz, Aveiro" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen />
        )}
        <a class="ct-map-card" href={business.directionsHref} target="_blank" rel="noopener">
          <span><strong>INOVACAR</strong>{business.address.full}</span>
          <span class="ct-map-go"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { estadoAgora } from '../lib/horario';

  const e = estadoAgora();
  const card = document.querySelector<HTMLElement>('[data-open-status]');
  if (card) {
    card.classList.add(e.aberto ? 'is-open' : 'is-closed');
    card.querySelector('[data-open-label]')!.textContent = e.titulo;
    card.querySelector('[data-open-value]')!.textContent = `· ${e.detalhe}`;
  }
  document.querySelector(`[data-dia="${e.dia}"]`)?.classList.add('is-today');

  // Copiar número (útil em computador ou para enviar a alguém).
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', async () => {
    const label = copy.querySelector('[data-copy-label]')!;
    try {
      await navigator.clipboard.writeText(copy.dataset.copy || '');
      label.textContent = 'Número copiado';
    } catch {
      label.textContent = copy.dataset.copy || '';
    }
    copy.classList.add('is-done');
    setTimeout(() => { label.textContent = 'Copiar número'; copy.classList.remove('is-done'); }, 2000);
  });
</script>

<style>
  .ct { padding-block: var(--space-7); background: var(--surface-muted); }
  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-areas: 'call hours' 'actions hours';
    gap: var(--space-4);
    align-items: start;
  }
  .ct-call { grid-area: call; }
  .ct-actions { grid-area: actions; }
  .ct-hours { grid-area: hours; }

  .ct-call {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-l);
    background: var(--brand-dark);
    color: var(--ink-on-dark);
    position: relative;
    overflow: hidden;
  }
  .ct-call::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: var(--brand-turquoise);
  }
  .ct-status { display: inline-flex; align-items: center; gap: 8px; justify-self: start; padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); font-size: var(--fs-small); font-weight: 600; }
  .ct-status-detail { color: var(--ink-on-dark-soft); font-weight: 500; }
  .ct-dot { width: 9px; height: 9px; border-radius: 50%; background: #9aa0ad; }
  .is-open .ct-dot { background: #22c55e; animation: ct-breathe 2.4s cubic-bezier(0.37, 0, 0.63, 1) infinite; }
  @keyframes ct-breathe { 0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); } 50% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); } }
  .ct-call-label { margin-top: var(--space-3); color: var(--ink-on-dark-soft); }
  .ct-phone {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 1.8rem + 3vw, 3.6rem);
    line-height: 1;
    color: var(--brand-turquoise);
    text-decoration: none;
    justify-self: start;
  }
  .ct-phone:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .ct-call-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .ct-copy.is-done { border-color: var(--brand-turquoise); color: var(--brand-turquoise); }

  .ct-actions { display: grid; gap: var(--space-2); }
  .ct-action {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-l);
    background: var(--surface-white);
    text-decoration: none;
    transition: transform var(--dur-quick) var(--ease), box-shadow var(--dur-standard) var(--ease);
  }
  .ct-action:hover { transform: translateY(-2px); box-shadow: 0 12px 24px -16px rgba(38, 41, 60, 0.45); }
  .ct-action:active { transform: scale(0.98); }
  .ct-action-icon { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 50%; background: rgba(54, 179, 175, 0.16); color: var(--brand-dark); }
  .ct-action-icon :global(svg) { width: 20px; height: 20px; }
  .ct-action-text { display: grid; gap: 2px; min-width: 0; }
  .ct-action-text span { color: var(--ink-soft); font-size: 0.92rem; overflow-wrap: anywhere; }
  .ct-action-go { width: 18px; height: 18px; margin-left: auto; flex: none; color: var(--ink-soft); transition: transform var(--dur-standard) var(--ease); }
  .ct-action:hover .ct-action-go { transform: translateX(4px); }

  .ct-h { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; margin-bottom: var(--space-3); }
  .ct-hours { padding: var(--space-5); border-radius: var(--radius-l); background: var(--surface-white); }
  .ct-week { display: grid; }
  .ct-day { display: flex; justify-content: space-between; gap: var(--space-3); padding: 9px 10px; margin-inline: -10px; border-radius: var(--radius-m); }
  .ct-day + .ct-day { border-top: 1px solid var(--line); }
  .ct-day span:last-child { font-weight: 600; }
  .ct-day.is-closed span:last-child { color: var(--ink-soft); font-weight: 500; }
  .ct-day.is-today { background: rgba(54, 179, 175, 0.16); border-top-color: transparent; font-weight: 600; }
  .ct-day.is-today + .ct-day { border-top-color: transparent; }
  .ct-day.is-today span:first-child::after { content: ' · hoje'; color: var(--brand-turquoise-ink); font-weight: 600; }
  .ct-note { margin-top: var(--space-3); font-size: var(--fs-small); color: var(--ink-soft); }

  .ct-map-wrap { padding-block: var(--space-7) var(--space-8); }
  .ct-map { position: relative; border-radius: var(--radius-l); overflow: hidden; aspect-ratio: 21 / 9; min-height: 320px; background: var(--line); box-shadow: var(--shadow-raised); }
  .ct-map :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .ct-map-card {
    position: absolute;
    left: var(--space-3);
    right: auto;
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: calc(100% - 2 * var(--space-3));
    padding: 12px 12px 12px 16px;
    border-radius: var(--radius-l);
    background: var(--surface-white);
    box-shadow: 0 10px 30px -10px rgba(38, 41, 60, 0.5);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .ct-map-card span:first-child { display: grid; color: var(--ink-soft); }
  .ct-map-card strong { color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .ct-map-go { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--brand-turquoise); color: var(--brand-dark); transition: transform var(--dur-standard) var(--ease); }
  .ct-map-go :global(svg) { width: 18px; height: 18px; }
  .ct-map-card:hover .ct-map-go { transform: translateX(3px); }

  @media (max-width: 960px) {
    .ct-grid { grid-template-columns: 1fr; grid-template-areas: 'call' 'actions' 'hours'; }
  }
  @media (max-width: 760px) {
    .ct { padding-block: var(--space-4) var(--space-5); }
    .ct-grid { gap: var(--space-3); }
    .ct-call { padding: var(--space-5) var(--space-4); }
    .ct-call-label { margin-top: var(--space-2); }
    .ct-call-actions { display: grid; grid-template-columns: 1fr 1fr; margin-top: var(--space-3); }
    .ct-call-actions .btn { padding-inline: 0.6em; font-size: 0.95rem; }
    /* Como chegar e Email lado a lado, em cartões curtos */
    .ct-actions { grid-template-columns: 1fr 1fr; }
    .ct-action { flex-direction: column; align-items: flex-start; gap: var(--space-2); padding: var(--space-4) var(--space-3); height: 100%; }
    .ct-action-text strong { font-size: 0.98rem; }
    .ct-action-text span { font-size: 0.82rem; }
    .ct-action-go { display: none; }
    .ct-hours { padding: var(--space-4); }
    .ct-h { font-size: 1.2rem; }
    .ct-map-wrap { padding-block: var(--space-5) var(--space-6); }
    .ct-map { aspect-ratio: 4 / 3; min-height: 0; }
  }
</style>
