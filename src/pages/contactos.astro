---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MapSection from '../components/MapSection.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Contactos', path: '/contactos/' },
];
---
<Base
  title="Contactos e marcações | INOVACAR, Aveiro | 934 514 368"
  description="Para marcar, ligue 934 514 368. INOVACAR, R. da Paz, 3800-587 Aveiro. Aberto de segunda a sexta, das 09:00 às 18:30."
  schema={[breadcrumbSchema(Astro.site!, crumbs)]}
>
  <PageHero
    title="Contactos da INOVACAR"
    lead="As marcações são feitas por telefone. Ligue, diga-nos o carro e o que está a acontecer, e combinamos o dia."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-block contact-block-main">
        <span class="t-label">Para marcar, ligue</span>
        <a class="contact-phone t-num" href={business.phoneHref}><Icon name="phone" class="contact-phone-icon" />{business.phoneDisplay}</a>
        <p class="t-soft">{business.hours.display}. {business.hours.closed}.</p>
      </div>
      <div class="contact-block">
        <span class="t-label">Morada</span>
        <address>{business.name}<br />{business.address.street}<br />{business.address.postalCode} {business.address.locality}</address>
        <a class="link-arrow" href={business.directionsHref} target="_blank" rel="noopener">Como chegar <Icon name="external" /></a>
      </div>
      <div class="contact-block">
        <span class="t-label">Horário</span>
        <dl class="contact-hours t-num">
          <div><dt>Segunda a sexta</dt><dd>09:00 às 18:30</dd></div>
          <div><dt>Sábado</dt><dd>Fechado</dd></div>
          <div><dt>Domingo</dt><dd>Fechado</dd></div>
        </dl>
        <p class="t-small t-soft">{business.hours.note}</p>
      </div>
      <div class="contact-block">
        {business.showEmail && (
          <>
            <span class="t-label">Email</span>
            <a class="contact-link" href={`mailto:${business.email}`}>{business.email}</a>
          </>
        )}
      </div>
    </div>
  </section>

  <MapSection />
</Base>

<style>
  .contact-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: var(--space-6); border-top: 2px solid var(--line-strong); padding-top: var(--space-5); }
  .contact-block { display: grid; gap: var(--space-2); align-content: start; justify-items: start; min-width: 0; }
  .contact-block .t-label { color: var(--ink-soft); }
  .contact-gap { margin-top: var(--space-3); }
  .contact-block address { font-style: normal; font-weight: 600; line-height: 1.5; }
  .contact-phone { display: inline-flex; align-items: center; gap: var(--space-3); font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 1.5rem + 2vw, 2.8rem); line-height: 1.05; text-decoration: none; color: var(--brand-dark); }
  .contact-phone:hover { color: var(--brand-turquoise-ink); }
  .contact-phone-icon { width: 0.8em; height: 0.8em; color: var(--brand-turquoise-ink); }
  .contact-link { font-weight: 600; overflow-wrap: anywhere; }
  .contact-hours { display: grid; gap: var(--space-1); width: 100%; }
  .contact-hours div { display: flex; justify-content: space-between; gap: var(--space-4); }
  .contact-hours dd { margin: 0; font-weight: 600; }
  @media (max-width: 960px) { .contact-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
