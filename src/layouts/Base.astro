---
import { u } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { business } from '../data/business';
import { schemaHorario } from '../lib/horario';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, schema = [], ogImage = '/images/og-inovacar.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const site = new URL(u('/'), Astro.site).toString().replace(/\/$/, '');

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${site}/#oficina`,
  name: business.name,
  url: `${site}/`,
  image: `${site}/images/og-inovacar.jpg`,
  logo: `${site}/images/logo-inovacar-480.png`,
  telephone: business.phoneIntl,
  ...(business.showEmail ? { email: business.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    postalCode: business.address.postalCode,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    addressCountry: business.address.country,
  },
  openingHoursSpecification: schemaHorario(),
  areaServed: ['Aveiro', 'Cacia'],
  sameAs: [business.googleProfile, ...business.social.map((s) => s.href)],
};
const allSchema = [localBusiness, ...schema];
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#26293C" />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u(ogImage), Astro.site)} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <script>
      import { aplicarHorario } from '../lib/horario';
      aplicarHorario();
    </script>
    <script>
      // Revela elementos [data-reveal] quando entram no ecrã; marca-os como .is-in uma única vez.
      // Os de recorte (data-reveal="clip") são vigiados pelo contentor: um elemento recortado a 100% nunca "entra" no ecrã.
      const groups = new Map<Element, HTMLElement[]>();
      // Nos carrosséis horizontais vigia-se o carrossel: os cartões fora do ecrã aparecem todos juntos com ele.
      const scroller = (el: HTMLElement) => {
        for (let p = el.parentElement; p && p !== document.body; p = p.parentElement) {
          if (/(auto|scroll)/.test(getComputedStyle(p).overflowX)) return p;
        }
        return null;
      };
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        const target = scroller(el) ?? (el.dataset.reveal === 'clip' && el.parentElement ? el.parentElement : el);
        groups.set(target, [...(groups.get(target) ?? []), el]);
      });
      const done = (el: HTMLElement) => {
        el.classList.add('is-in');
        el.addEventListener('transitionend', () => el.classList.add('is-done'), { once: true });
      };
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        groups.forEach((els) => els.forEach(done));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              groups.get(e.target)?.forEach(done);
              io.unobserve(e.target);
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        groups.forEach((_, target) => io.observe(target));
      }
    </script>
  </body>
</html>
