---
// Ícones dos serviços a dois tons (traço escuro + preenchimento turquesa), 48x48.
// Cada um tem uma peça animada (classes si-*) que mexe quando o cartão entra no ecrã ou ao passar o rato.
interface Props {
  name: 'oil' | 'brake' | 'diagnostic' | 'battery' | 'suspension' | 'clutch' | 'engine' | 'inspection';
  class?: string;
}
const { name, class: cls = '', ...rest } = Astro.props;

const teeth = Array.from({ length: 8 }, (_, k) => `<rect x="21.5" y="7" width="5" height="6" rx="1" transform="rotate(${k * 45} 24 24)" class="si-solid"/>`).join('');
const holes = Array.from({ length: 5 }, (_, k) => {
  const a = (k * 72 - 90) * (Math.PI / 180);
  return `<circle cx="${(24 + 9.5 * Math.cos(a)).toFixed(2)}" cy="${(24 + 9.5 * Math.sin(a)).toFixed(2)}" r="1.7"/>`;
}).join('');

const paths: Record<Props['name'], string> = {
  oil: `<path class="si-tint" d="M24 6s11 12.5 11 20.5a11 11 0 0 1-22 0C13 18.5 24 6 24 6z"/>
        <path d="M18.5 28a5.5 5.5 0 0 0 5.5 5.5"/>
        <path class="si-drip si-solid" d="M24 39.5s2.6 2.9 2.6 4.4a2.6 2.6 0 0 1-5.2 0c0-1.5 2.6-4.4 2.6-4.4z"/>`,
  brake: `<g class="si-spin"><circle class="si-tint" cx="24" cy="24" r="16"/><circle cx="24" cy="24" r="4.5"/>${holes}</g>
          <path class="si-solid" d="M31.5 7.5a17.5 17.5 0 0 1 9 9.5l-5.6 2.2a11.5 11.5 0 0 0-5.7-6z"/>`,
  diagnostic: `<rect class="si-tint" x="5" y="9" width="38" height="25" rx="3"/>
               <path d="M18 41h12M24 34v7"/>
               <path class="si-draw si-accent" pathLength="1" d="M10 22h7l3-7 5 13 3-6h10"/>`,
  battery: `<rect class="si-tint" x="6" y="14" width="36" height="24" rx="3"/>
            <path d="M13 14v-4h6v4M29 14v-4h6v4"/>
            <rect class="si-bar si-solid" x="11" y="19" width="7" height="14" rx="1.5" style="--b:0"/>
            <rect class="si-bar si-solid" x="20.5" y="19" width="7" height="14" rx="1.5" style="--b:1"/>
            <rect class="si-bar si-solid" x="30" y="19" width="7" height="14" rx="1.5" style="--b:2"/>`,
  suspension: `<path class="si-faint" d="M24 9v30"/>
               <path class="si-spring" d="M17 13l14 3.5-14 3.5 14 3.5-14 3.5 14 3.5-14 3.5 14 3.5"/>
               <rect class="si-solid" x="13" y="6" width="22" height="5" rx="1.5"/>
               <rect class="si-solid" x="13" y="37" width="22" height="5" rx="1.5"/>`,
  clutch: `<g class="si-spin">${teeth}<circle class="si-tint" cx="24" cy="24" r="12"/><circle cx="24" cy="24" r="4.5"/></g>`,
  engine: `<path class="si-belt si-accent" d="M9.2 26.5 31 11.2M19.2 36.4 38.5 20.3"/>
           <g class="si-spin"><circle class="si-tint" cx="15" cy="31" r="8"/><path d="M15 25v12M9 31h12"/></g>
           <g class="si-spin si-spin-fast"><circle class="si-tint" cx="34" cy="15" r="5.5"/><path d="M34 11v8M30 15h8"/></g>`,
  inspection: `<rect class="si-tint" x="10" y="9" width="28" height="33" rx="3"/>
               <path class="si-solid" d="M18 6h12v6H18z"/>
               <path class="si-draw si-accent" pathLength="1" d="M16.5 26l5.5 5.5 10-11"/>
               <path class="si-faint" d="M17 37h14"/>`,
};
---
<svg
  {...rest}
  class={`si ${cls}`}
  width="48"
  height="48"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
