---
// Ícones dos serviços, traço 2px, mesmo sistema que Icon.astro.
interface Props {
  name: 'oil' | 'brake' | 'diagnostic' | 'battery' | 'suspension' | 'clutch' | 'engine' | 'inspection';
  class?: string;
}
const { name, class: cls = '', ...rest } = Astro.props;
const paths: Record<Props['name'], string> = {
  oil: '<path d="M12 3s6 6.4 6 11a6 6 0 0 1-12 0c0-4.6 6-11 6-11z"/><path d="M9 14.5a3 3 0 0 0 3 3"/>',
  brake: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M5.5 6.5a9 9 0 0 1 5-3.3M18.5 17.5a9 9 0 0 1-5 3.3"/>',
  diagnostic: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  battery: '<rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 4v3M17 4v3M7 13h4M15 11v4M13 13h4"/>',
  suspension: '<path d="M12 2v3M12 19v3"/><path d="M8 5h8l-8 3h8l-8 3h8l-8 3h8l-8 3h8"/>',
  clutch: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1"/>',
  engine: '<circle cx="7" cy="12" r="3.5"/><circle cx="17" cy="12" r="3.5"/><path d="M7 8.5h10M7 15.5h10"/>',
  inspection: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V2h6v2"/><path d="M9 12.5l2 2 4-4.5"/>',
};
---
<svg {...rest} class={cls} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
