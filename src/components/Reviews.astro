---
// Avaliações: só aparecem avaliações reais (widget ou texto colado do Google).
// Sem nenhuma, a secção mostra apenas o atalho para as avaliações na ficha Google.
import Icon from './Icon.astro';
import { business, reviewsEmbed, pastedReviews } from '../data/business';

const reviews = pastedReviews.filter((r) => r.text.trim());
---
<section class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews-head">
      <div class="section-head reviews-intro">
        <h2 class="t-h2" id="reviews-title">O que dizem os clientes</h2>
        <p class="t-lead">As avaliações são publicadas pelos clientes na nossa ficha do Google.</p>
      </div>
      <a class="btn btn-outline-dark" href={business.googleProfile} target="_blank" rel="noopener">
        Ver avaliações no Google <Icon name="external" class="btn-icon" />
      </a>
    </div>

    {reviewsEmbed && <div class="reviews-embed" set:html={reviewsEmbed} />}

    {reviews.length > 0 && (
      <ul role="list" class="reviews-cards">
        {reviews.map((r) => (
          <li class="review-card">
            <blockquote>
              <p>“{r.text}”</p>
              <footer class="review-author">{r.author} · avaliação no Google</footer>
            </blockquote>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .reviews-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--space-5); }
  .reviews-intro { margin-bottom: 0; }
  .reviews-embed { margin-top: var(--space-7); min-height: 320px; }
  .reviews-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); margin-top: var(--space-7); }
  .review-card { background: var(--surface-white); border: 1px solid var(--line); border-top: 3px solid var(--brand-turquoise); border-radius: var(--radius-s); padding: var(--space-5); }
  .review-card blockquote { margin: 0; display: grid; gap: var(--space-4); }
  .review-author { font-weight: 600; font-size: var(--fs-small); color: var(--ink-soft); }
</style>
