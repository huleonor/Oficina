---
// Faixa prática por baixo do hero: morada, horário com estado ao vivo, telefone.
// Cartões claros (mesmo estilo das linhas de contactos / sobre-nós).
import Icon from './Icon.astro';
import { business } from '../data/business';
---
<section class="info" id="factos" aria-label="Informação prática">
  <div class="container">
    <ul role="list" class="info-list">
      <li>
        <a class="info-item" href={business.directionsHref} target="_blank" rel="noopener">
          <span class="info-icon"><Icon name="pin" /></span>
          <span class="info-text">
            <span class="info-label">Morada</span>
            <span class="info-value">{business.address.street}, Aveiro</span>
          </span>
          <Icon name="arrow" class="info-go" />
        </a>
      </li>
      <li>
        <div class="info-item" data-open-status>
          <span class="info-icon info-icon-status"><span class="info-dot" aria-hidden="true"></span><Icon name="clock" /></span>
          <span class="info-text">
            <span class="info-label" data-open-label>Horário</span>
            <span class="info-value t-num" data-open-value>{business.hours.short}</span>
          </span>
        </div>
      </li>
      <li>
        <a class="info-item" href={business.phoneHref}>
          <span class="info-icon info-icon-phone"><Icon name="phone" /></span>
          <span class="info-text">
            <span class="info-label">Ligue para marcar</span>
            <span class="info-value t-num">{business.phoneDisplay}</span>
          </span>
          <Icon name="arrow" class="info-go" />
        </a>
      </li>
    </ul>
  </div>
</section>

<script>
  import { estadoAgora } from '../lib/horario';
  const el = document.querySelector<HTMLElement>('[data-open-status]');
  if (el) {
    const e = estadoAgora();
    el.classList.add(e.aberto ? 'is-open' : 'is-closed');
    el.querySelector('[data-open-label]')!.textContent = e.titulo;
    el.querySelector('[data-open-value]')!.textContent = e.detalhe;
  }
</script>

<style>
  .info {
    background: var(--surface-muted);
    color: var(--ink);
    position: relative;
    z-index: 1;
    padding-block: var(--space-4);
  }
  .info-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .info-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    height: 100%;
    border-radius: var(--radius-l);
    background: var(--surface-white);
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-quick) var(--ease), box-shadow var(--dur-standard) var(--ease);
  }
  a.info-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -16px rgba(38, 41, 60, 0.45);
  }
  .info-icon {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(54, 179, 175, 0.16);
    color: var(--brand-dark);
    transition: transform var(--dur-standard) var(--ease);
  }
  .info-icon :global(svg) { width: 20px; height: 20px; }
  a.info-item:hover .info-icon { transform: scale(1.08); }
  .info-icon-phone :global(svg) { transform-origin: 50% 50%; }
  a.info-item:hover .info-icon-phone :global(svg) { animation: ring 600ms var(--ease); }
  @keyframes ring {
    0%, 100% { transform: rotate(0); }
    20% { transform: rotate(-14deg); }
    40% { transform: rotate(12deg); }
    60% { transform: rotate(-8deg); }
    80% { transform: rotate(4deg); }
  }
  .info-dot {
    position: absolute;
    top: 1px;
    right: 1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--surface-white);
    background: #9aa0ad;
    display: none;
  }
  .is-open .info-dot, .is-closed .info-dot { display: block; }
  .is-open .info-dot { background: #22c55e; animation: breathe 2.4s cubic-bezier(0.37, 0, 0.63, 1) infinite; }
  @keyframes breathe {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
    50% { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
  }
  .info-text { display: grid; gap: 2px; min-width: 0; }
  .info-label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .info-value { font-weight: 600; font-size: 1.08rem; line-height: 1.25; }
  .info-go {
    width: 20px;
    height: 20px;
    margin-left: auto;
    flex: none;
    color: var(--ink-soft);
    transition: transform var(--dur-standard) var(--ease);
  }
  a.info-item:hover .info-go { transform: translateX(4px); }

  @media (max-width: 760px) {
    .info { padding-block: var(--space-3); }
    .info .container { padding: 0; }
    .info-list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding: 2px var(--gutter-r) var(--space-2) var(--gutter);
      gap: var(--space-2);
    }
    .info-list::-webkit-scrollbar { display: none; }
    .info-list > li { flex: 0 0 auto; scroll-snap-align: start; }
    .info-item {
      padding: 12px 14px 12px 12px;
      min-width: min(78vw, 280px);
    }
    .info-icon { width: 36px; height: 36px; }
    .info-icon :global(svg) { width: 17px; height: 17px; }
    .info-label { font-size: 0.68rem; }
    .info-value { font-size: 0.95rem; white-space: nowrap; }
    .info-go { display: none; }
  }
</style>
