---
// Mapa da oficina a toda a largura, com morada, horário e os dois atalhos: ligar e como chegar.
import Icon from './Icon.astro';
import { business, mapEmbed } from '../data/business';

interface Props {
  title?: string;
}
const { title = 'Onde estamos' } = Astro.props;
---
<section class="section section-muted map-section" aria-labelledby="map-title">
  <div class="container">
    <div class="map-head" data-reveal>
      <div class="map-copy">
        <h2 class="t-h2" id="map-title">{title}</h2>
        <p class="t-lead">{business.address.full}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={business.phoneHref}><Icon name="phone" class="btn-icon" />Ligar {business.phoneDisplay}</a>
        <a class="btn btn-outline-dark" href={business.directionsHref} target="_blank" rel="noopener"><Icon name="pin" class="btn-icon" />Como chegar</a>
      </div>
    </div>
    <div class="map-frame" data-reveal>
      {mapEmbed ? (
        <Fragment set:html={mapEmbed} />
      ) : (
        <iframe
          src={business.mapSrc}
          title="Mapa com a localização da INOVACAR na R. da Paz, Aveiro"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      )}
      <a class="map-card" href={business.directionsHref} target="_blank" rel="noopener">
        <span><strong>INOVACAR</strong>{business.address.full}</span>
        <span class="map-card-go"><Icon name="arrow" /></span>
      </a>
    </div>
    <p class="map-hours t-small t-soft t-num"><Icon name="clock" class="map-hours-icon" />{business.hours.display}. {business.hours.closed}.</p>
  </div>
</section>

<style>
  .map-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--space-5); margin-bottom: var(--space-6); }
  .map-copy { display: grid; gap: var(--space-3); }
  .map-frame { border-radius: var(--radius-l); overflow: hidden; background: var(--line); aspect-ratio: 21 / 9; min-height: 340px; box-shadow: var(--shadow-raised); }
  .map-frame :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .map-hours { display: none; gap: var(--space-2); align-items: center; margin-top: var(--space-4); }
  .map-hours-icon { width: 18px; height: 18px; flex: none; }
  .map-frame { position: relative; }
  .map-card {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    max-width: calc(100% - 24px);
    padding: 12px 12px 12px 16px;
    border-radius: var(--radius-l);
    background: var(--surface-white);
    box-shadow: 0 10px 30px -10px rgba(38, 41, 60, 0.5);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .map-card span:first-child { display: grid; color: var(--ink-soft); }
  .map-card strong { color: var(--ink); font-family: var(--font-display); font-size: 1.05rem; }
  .map-card-go { display: grid; place-items: center; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--brand-turquoise); color: var(--brand-dark); transition: transform var(--dur-standard) var(--ease); }
  .map-card-go :global(svg) { width: 18px; height: 18px; }
  .map-card:hover .map-card-go { transform: translateX(3px); }
  @media (max-width: 760px) {
    .map-frame { aspect-ratio: 4 / 3; min-height: 0; }
    .map-head { margin-bottom: var(--space-4); }
    .map-head .t-lead, .map-head .btn-row, .map-hours { display: none; }
  }
</style>
