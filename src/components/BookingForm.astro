---
// Pedido de marcação desenhado como uma ordem de reparação (direção A).
// Envia para formEndpoint (data/business.ts). Um pedido não é uma marcação confirmada.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { business, formEndpoint } from '../data/business';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);
const localidades = (await getCollection('localidades')).sort((a, b) => a.data.order - b.data.order);
---
<div class="booking" id="pedido" data-booking data-endpoint={formEndpoint}>
  <form class="order" novalidate data-booking-form aria-labelledby="pedido-title">
    <div class="order-head">
      <h2 class="order-title" id="pedido-title">Pedido de marcação</h2>
      <span class="t-label order-head-note">INOVACAR · R. da Paz, Aveiro</span>
    </div>

    <p class="order-notice" id="pedido-aviso">
      Este pedido não é uma marcação confirmada. A marcação fica combinada depois de falarmos consigo.
    </p>

    <div class="order-error" role="alert" data-booking-summary hidden></div>

    <fieldset class="order-section">
      <legend class="t-label order-legend">Cliente</legend>
      <div class="order-row">
        <div class="field">
          <label class="field-label" for="f-nome">Nome</label>
          <input class="field-input" id="f-nome" name="nome" type="text" autocomplete="name" required aria-describedby="e-nome" />
          <p class="field-error" id="e-nome" hidden>Escreva o seu nome.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f-telefone">Telefone</label>
          <input class="field-input t-num" id="f-telefone" name="telefone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="e-telefone" />
          <p class="field-error" id="e-telefone" hidden>Escreva um número com pelo menos 9 algarismos.</p>
        </div>
      </div>
      <div class="order-row">
        <div class="field">
          <label class="field-label" for="f-email">Email <span class="field-opt">(opcional)</span></label>
          <input class="field-input" id="f-email" name="email" type="email" autocomplete="email" aria-describedby="e-email" />
          <p class="field-error" id="e-email" hidden>Verifique o email, por exemplo nome@exemplo.pt.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f-localidade">Localidade <span class="field-opt">(opcional)</span></label>
          <select class="field-input" id="f-localidade" name="localidade">
            <option value="">Escolha</option>
            {localidades.map((l) => <option value={l.data.city}>{l.data.city}</option>)}
            <option value="Outra">Outra</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset class="order-section">
      <legend class="t-label order-legend">Viatura</legend>
      <div class="order-row order-row-3">
        <div class="field">
          <label class="field-label" for="f-carro">Marca e modelo</label>
          <input class="field-input" id="f-carro" name="carro" type="text" required placeholder="Ex.: Opel Astra" aria-describedby="e-carro" />
          <p class="field-error" id="e-carro" hidden>Indique a marca e o modelo.</p>
        </div>
        <div class="field">
          <label class="field-label" for="f-ano">Ano <span class="field-opt">(opcional)</span></label>
          <input class="field-input t-num" id="f-ano" name="ano" type="text" inputmode="numeric" maxlength="4" placeholder="Ex.: 2015" />
        </div>
        <div class="field">
          <label class="field-label" for="f-km">Quilómetros <span class="field-opt">(opcional)</span></label>
          <input class="field-input t-num" id="f-km" name="quilometros" type="text" inputmode="numeric" placeholder="Ex.: 120 000" />
        </div>
      </div>
    </fieldset>

    <fieldset class="order-section">
      <legend class="t-label order-legend">Trabalho pretendido</legend>
      <div class="checks">
        {servicos.map((s) => (
          <label class="check">
            <input class="check-input" type="checkbox" name="servicos" value={s.data.name} />
            <svg class="check-box" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="2" /><path d="M5.5 11.5l3.5 3.5 7.5-8" /></svg>
            <span>{s.data.name}</span>
          </label>
        ))}
        <label class="check">
          <input class="check-input" type="checkbox" name="servicos" value="Não sei / outro" />
          <svg class="check-box" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="2" /><path d="M5.5 11.5l3.5 3.5 7.5-8" /></svg>
          <span>Não sei / outro</span>
        </label>
      </div>
      <div class="field field-full">
        <label class="field-label" for="f-descricao">O que o carro está a fazer?</label>
        <textarea class="field-input" id="f-descricao" name="descricao" rows="4" required aria-describedby="e-descricao" placeholder="Ex.: chia ao travar desde a semana passada, sobretudo a frio."></textarea>
        <p class="field-error" id="e-descricao" hidden>Descreva em poucas palavras o que se passa.</p>
      </div>
      <div class="field field-full">
        <label class="field-label" for="f-dia">Dia preferido <span class="field-opt">(opcional)</span></label>
        <input class="field-input" id="f-dia" name="dia_preferido" type="text" placeholder="Ex.: terça de manhã" />
      </div>
    </fieldset>

    <div class="order-foot">
      <label class="check check-consent">
        <input class="check-input" type="checkbox" name="consentimento" value="sim" required aria-describedby="e-consent" />
        <svg class="check-box" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="2" /><path d="M5.5 11.5l3.5 3.5 7.5-8" /></svg>
        <span>Aceito que a INOVACAR use estes dados para responder a este pedido.</span>
      </label>
      <p class="field-error" id="e-consent" hidden>Para enviarmos o pedido, precisamos da sua autorização.</p>
      <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary order-submit" type="submit" data-booking-submit>
        <span class="order-submit-text">Enviar pedido</span>
        <span class="order-spinner" aria-hidden="true"></span>
      </button>
      <p class="t-small t-soft">Prefere falar já? Ligue <a class="t-num" href={business.phoneHref}>{business.phoneDisplay}</a>.</p>
    </div>
  </form>

  <div class="order-done" data-booking-done tabindex="-1" hidden>
    <svg class="done-check" viewBox="0 0 52 52" aria-hidden="true"><rect x="2" y="2" width="48" height="48" rx="4" /><path d="M14 27l8 8 16-18" /></svg>
    <h2 class="t-h2" data-booking-done-title>Pedido enviado. Obrigado.</h2>
    <p class="t-lead">Recebemos o seu pedido. A marcação ainda não está confirmada: fica combinada quando falarmos consigo.</p>
    <p>Se for urgente, ligue para <a class="t-num" href={business.phoneHref}>{business.phoneDisplay}</a>.</p>
    <button class="btn btn-outline-dark" type="button" data-booking-again>Enviar outro pedido</button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-booking]');
  const form = root?.querySelector<HTMLFormElement>('[data-booking-form]');
  const done = root?.querySelector<HTMLElement>('[data-booking-done]');
  const summary = root?.querySelector<HTMLElement>('[data-booking-summary]');
  const submit = root?.querySelector<HTMLButtonElement>('[data-booking-submit]');

  const rules: Record<string, (v: string, el: HTMLInputElement) => boolean> = {
    nome: (v) => v.trim().length > 1,
    telefone: (v) => v.replace(/\D/g, '').length >= 9,
    email: (v) => v.trim() === '' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),
    carro: (v) => v.trim().length > 1,
    descricao: (v) => v.trim().length > 3,
    consentimento: (_v, el) => el.checked,
  };
  const errorId: Record<string, string> = { consentimento: 'e-consent' };

  const check = (el: HTMLInputElement) => {
    const rule = rules[el.name];
    if (!rule) return true;
    const ok = rule(el.value, el);
    const err = document.getElementById(errorId[el.name] ?? `e-${el.name}`);
    el.toggleAttribute('aria-invalid', !ok);
    if (err) err.hidden = ok;
    return ok;
  };

  const showSummary = (html: string) => {
    if (!summary) return;
    summary.innerHTML = html;
    summary.hidden = false;
    summary.classList.remove('shake');
    void summary.offsetWidth;
    summary.classList.add('shake');
  };

  form?.addEventListener('focusout', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name && el.hasAttribute('aria-invalid')) check(el);
  });
  form?.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.hasAttribute('aria-invalid')) check(el);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !root || !submit) return;
    const fields = [...form.querySelectorAll<HTMLInputElement>('input[name], textarea[name]')].filter((el) => rules[el.name]);
    const invalid = fields.filter((el) => !check(el));
    if (invalid.length) {
      showSummary(`Faltam ${invalid.length === 1 ? 'um campo' : `${invalid.length} campos`} por preencher. Corrija os campos assinalados.`);
      invalid[0].focus();
      return;
    }

    const endpoint = root.dataset.endpoint;
    if (!endpoint) {
      showSummary(`O envio pelo site ainda não está ligado. Ligue para <a href="tel:+351934514368">934 514 368</a> e fazemos o pedido por telefone.`);
      return;
    }

    summary && (summary.hidden = true);
    submit.disabled = true;
    submit.classList.add('is-loading');
    const data = new FormData(form);
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      const nome = String(data.get('nome') ?? '').trim().split(' ')[0];
      const title = done?.querySelector('[data-booking-done-title]');
      if (title && nome) title.textContent = `Pedido enviado. Obrigado, ${nome}.`;
      form.hidden = true;
      if (done) { done.hidden = false; done.focus(); }
    } catch {
      showSummary(`Não foi possível enviar o pedido. Verifique a ligação à internet e tente de novo, ou ligue para <a href="tel:+351934514368">934 514 368</a>.`);
    } finally {
      submit.disabled = false;
      submit.classList.remove('is-loading');
    }
  });

  root?.querySelector('[data-booking-again]')?.addEventListener('click', () => {
    if (!form || !done) return;
    form.reset();
    done.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>('#f-nome')?.focus();
  });
</script>

<style>
  .booking { --danger: #b42318; }
  .order {
    background: var(--surface-white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--brand-dark);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-raised);
  }
  .order-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-bottom: 2px solid var(--line-strong);
  }
  .order-title { font-family: var(--font-display); font-size: 1.7rem; line-height: 1.1; }
  .order-head-note { color: var(--ink-soft); }
  .order-notice { margin: var(--space-4) var(--space-5) 0; padding: var(--space-3) var(--space-4); background: var(--surface-muted); border-radius: var(--radius-s); font-size: var(--fs-small); }
  .order-error {
    margin: var(--space-4) var(--space-5) 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--danger);
    border-radius: var(--radius-s);
    color: var(--danger);
    font-weight: 600;
    font-size: var(--fs-small);
  }
  .order-error :global(a) { color: inherit; }
  .order-error.shake { animation: shake 320ms var(--ease); }
  @keyframes shake {
    20% { transform: translateX(-6px); }
    45% { transform: translateX(5px); }
    70% { transform: translateX(-3px); }
    100% { transform: translateX(0); }
  }
  .order-section { border: 0; margin: 0; padding: var(--space-5) var(--space-5) var(--space-2); min-width: 0; }
  .order-section + .order-section { border-top: 1px solid var(--line); }
  .order-legend { float: left; width: 100%; padding: 0; margin-bottom: var(--space-2); color: var(--brand-turquoise-ink); }
  .order-legend + * { clear: both; }
  .order-row { display: grid; grid-template-columns: 1fr 1fr; }
  .order-row-3 { grid-template-columns: 2fr 1fr 1fr; }

  /* Campos como caixas da ficha: etiqueta no canto, linha a separar. */
  .field { display: grid; gap: 2px; padding: var(--space-3) 0 var(--space-4); border-bottom: 1px solid var(--line); min-width: 0; }
  .order-row .field + .field { padding-left: var(--space-4); border-left: 1px solid var(--line); }
  .order-row .field:not(:last-child) { padding-right: var(--space-4); }
  .field-full { margin-top: var(--space-2); }
  .field-label { font-size: var(--fs-small); font-weight: 600; color: var(--ink-soft); }
  .field-opt { font-weight: 400; }
  .field-input {
    width: 100%;
    min-height: 44px;
    padding: 8px 0;
    border: 0;
    border-bottom: 2px solid transparent;
    margin-top: 4px;
    padding-inline: 10px;
    background: #f8fafa;
    border-bottom-color: var(--line);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink);
    border-radius: 0;
    transition: border-color var(--dur-quick) var(--ease), background-color var(--dur-quick) var(--ease);
  }
  textarea.field-input { resize: vertical; line-height: 1.5; }
  select.field-input { cursor: pointer; }
  .field-input::placeholder { color: #6b7083; font-weight: 400; }
  .field-input:hover { background: var(--surface-muted); }
  .field-input:focus { outline: none; border-bottom-color: var(--brand-turquoise); background: var(--surface-muted); }
  .field-input:focus-visible { outline: none; }
  .field-input[aria-invalid] { border-bottom-color: var(--danger); }
  .field-error { color: var(--danger); font-size: var(--fs-small); font-weight: 600; }

  .checks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-5); }
  .check { position: relative; display: flex; gap: var(--space-3); align-items: flex-start; padding: 10px 0; cursor: pointer; }
  .check-input { position: absolute; opacity: 0; width: 22px; height: 22px; margin: 0; cursor: pointer; }
  .check-box { width: 22px; height: 22px; flex: none; margin-top: 1px; }
  .check-box rect { fill: var(--surface-white); stroke: var(--brand-dark); stroke-width: 1.5; transition: fill var(--dur-quick) var(--ease); }
  .check-box path {
    fill: none;
    stroke: var(--brand-turquoise-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    transition: stroke-dashoffset 280ms var(--ease);
  }
  .check:hover .check-box rect { fill: var(--surface-muted); }
  .check-input:checked + .check-box path { stroke-dashoffset: 0; }
  .check-input:focus-visible + .check-box { outline: 3px solid var(--brand-turquoise); outline-offset: 2px; border-radius: 2px; }
  .check-input[aria-invalid] + .check-box rect { stroke: var(--danger); }

  .order-foot { display: grid; gap: var(--space-4); justify-items: start; padding: var(--space-5); border-top: 2px solid var(--line-strong); }
  .order-submit { position: relative; min-width: 200px; }
  .order-spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid var(--brand-dark);
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  .order-submit.is-loading .order-spinner { display: inline-block; }
  .order-submit.is-loading .order-submit-text::after { content: '…'; }
  .order-submit:disabled { cursor: progress; opacity: 0.85; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .order-done {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-7) var(--space-6);
    background: var(--surface-white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--brand-turquoise);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-raised);
    animation: done-in 320ms var(--ease-out);
  }
  .order-done:focus { outline: none; }
  .order-done[hidden] { display: none; }
  .done-check { width: 52px; height: 52px; }
  .done-check rect { fill: var(--brand-dark); }
  .done-check path { fill: none; stroke: var(--brand-turquoise); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw 360ms var(--ease) 160ms forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes done-in { from { opacity: 0; transform: scale(0.98); } }

  @media (max-width: 640px) {
    .order-row, .order-row-3 { grid-template-columns: 1fr; }
    .order-row .field + .field { padding-left: 0; border-left: 0; }
    .order-row .field:not(:last-child) { padding-right: 0; }
    .checks { grid-template-columns: 1fr; }
    .order-section, .order-head, .order-foot { padding-inline: var(--space-4); }
    .order-notice, .order-error { margin-inline: var(--space-4); }
    .order-submit { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .done-check path { stroke-dashoffset: 0; animation: none; }
  }
</style>
