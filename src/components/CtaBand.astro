---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import { business } from '../data/business';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Fale connosco sobre o seu carro',
  text = 'Ligue para a oficina ou envie um pedido de marcação. Diga-nos o que o carro está a fazer.',
} = Astro.props;
---
<section class="cta section-dark" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2 class="t-h2" id="cta-title">{title}</h2>
      <p class="t-lead">{text}</p>
    </div>
    <div class="cta-panel">
      <a class="cta-phone t-num" href={business.phoneHref}>
        <Icon name="phone" class="cta-phone-icon" />{business.phoneDisplay}
      </a>
      <p class="cta-hours t-num"><Icon name="clock" class="cta-hours-icon" />{business.hours.display}. {business.hours.closed}.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={business.phoneHref}><Icon name="phone" class="btn-icon" />Ligar para a oficina</a>
        <a class="btn btn-outline-light" href={u('/contactos/#pedido')}><Icon name="calendar" class="btn-icon" />Pedir marcação</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-8); border-top: 4px solid var(--brand-turquoise); }
  .cta-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); align-items: center; }
  .cta-copy { display: grid; gap: var(--space-4); }
  .cta-panel { display: grid; gap: var(--space-4); justify-items: start; }
  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
    line-height: 1;
    color: var(--brand-turquoise);
    text-decoration: none;
  }
  .cta-phone:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .cta-phone-icon { width: 0.8em; height: 0.8em; }
  .cta-hours { display: flex; gap: var(--space-2); align-items: flex-start; color: var(--ink-on-dark-soft); }
  .cta-hours-icon { width: 20px; height: 20px; flex: none; margin-top: 3px; }
  @media (max-width: 860px) { .cta-inner { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
