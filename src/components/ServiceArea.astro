---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { business, mapEmbed } from '../data/business';

const localidades = (await getCollection('localidades')).sort((a, b) => a.data.order - b.data.order);
---
<section class="section section-muted area" aria-labelledby="area-title">
  <div class="container area-grid">
    <div class="area-copy">
      <h2 class="t-h2" id="area-title">Uma oficina, perto de Cacia e Aveiro</h2>
      <p class="t-lead">A INOVACAR fica na {business.address.street}, em Aveiro. Recebemos o seu carro na oficina; veja a que distância fica da sua zona.</p>
      <ul role="list" class="area-links">
        {localidades.map((l) => (
          <li>
            <a class="area-link" href={u(`/localidades/${l.id}/`)}>
              <span class="area-city">{l.data.city}</span>
              <span class="area-time">{l.data.driveTime.replace(' (estimativa)', '')}</span>
              <Icon name="arrow" class="area-arrow" />
            </a>
          </li>
        ))}
      </ul>
      <a class="link-arrow" href={u('/localidades/')}>Ver todas as localidades <Icon name="arrow" /></a>
    </div>

    {mapEmbed ? (
      <div class="area-map" set:html={mapEmbed} />
    ) : (
      <div class="missing-block area-map area-missing" role="note">
        <strong>Mapa Google</strong>
        <span>Espaço reservado para o mapa incorporado (Partilhar &gt; Incorporar mapa). Ainda não foi fornecido.</span>
        <a class="link-arrow" href={business.googleProfile} target="_blank" rel="noopener">Abrir a localização no Google Maps <Icon name="external" /></a>
      </div>
    )}
  </div>
</section>

<style>
  .area-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-7); align-items: start; }
  .area-copy { display: grid; gap: var(--space-5); }
  .area-links { border-top: 2px solid var(--line-strong); }
  .area-link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .area-city { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; }
  .area-time { color: var(--ink-soft); font-size: var(--fs-small); text-align: right; }
  .area-arrow { width: 20px; height: 20px; transition: transform var(--dur-standard) var(--ease); }
  .area-link:hover .area-arrow { transform: translateX(4px); }
  .area-link:hover .area-city { color: var(--brand-turquoise-ink); }
  .area-map { min-height: 460px; position: sticky; top: calc(var(--header-h) + 24px); }
  .area-map :global(iframe) { width: 100%; height: 100%; min-height: 460px; border: 0; border-radius: var(--radius-l); }
  .area-missing { text-align: center; justify-items: center; }
  @media (max-width: 960px) {
    .area-grid { grid-template-columns: 1fr; }
    .area-map { position: static; min-height: 320px; }
  }
  @media (max-width: 420px) { .area-time { display: none; } .area-link { grid-template-columns: 1fr auto; } }
</style>
